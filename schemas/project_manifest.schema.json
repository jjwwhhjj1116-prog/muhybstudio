{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V13 project manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "title",
    "format",
    "workflow_version",
    "workflow_git_sha",
    "targets",
    "execution",
    "character_images",
    "video",
    "google_docs",
    "private_sync"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "episodic-animation"
    },
    "workflow_version": {
      "const": "3.0.0"
    },
    "workflow_git_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "targets": {
      "type": "object",
      "required": [
        "episode_count",
        "episode_target_minutes",
        "script_chunks",
        "allow_subchunks"
      ],
      "properties": {
        "episode_count": {
          "type": "integer",
          "minimum": 1
        },
        "episode_target_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "runtime_tolerance_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "script_chunks": {
          "type": "integer",
          "minimum": 1
        },
        "allow_subchunks": {
          "type": "boolean"
        }
      }
    },
    "execution": {
      "type": "object"
    },
    "character_images": {
      "type": "object"
    },
    "video": {
      "type": "object"
    },
    "google_docs": {
      "type": "object"
    },
    "private_sync": {
      "type": "object"
    }
  }
}
