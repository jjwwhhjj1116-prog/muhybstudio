{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuxia-studio.local/schemas/project_manifest.schema.json",
  "title": "Wuxia Production Project Manifest",
  "type": "object",
  "required": ["schemaVersion", "projectId", "title", "format", "production", "stages"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "projectId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "format": {"enum": ["feature_film", "episode", "compilation"]},
    "production": {
      "type": "object",
      "required": ["targetRuntimeMinutes", "targetCharacters", "scriptChunkCount", "visualChunkMaxScenes"],
      "properties": {
        "targetRuntimeMinutes": {"type": "integer", "minimum": 1},
        "targetCharacters": {
          "type": "object",
          "required": ["countWhitespace", "min", "max"],
          "properties": {
            "countWhitespace": {"const": true},
            "min": {"type": "integer", "minimum": 1},
            "max": {"type": "integer", "minimum": 1}
          }
        },
        "scriptChunkCount": {"type": "integer", "minimum": 1},
        "visualChunkMaxScenes": {"type": "integer", "minimum": 1, "maximum": 25},
        "sceneSentenceTarget": {"type": "string", "default": "2-3"},
        "characterImageQuality": {"const": "Medium"},
        "videoEngine": {"type": "string", "default": "Google Flow"}
      }
    },
    "canonDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "priority", "revision"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "priority": {"type": "integer", "minimum": 1},
          "revision": {"type": "string"},
          "hash": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "stages": {
      "type": "object",
      "required": ["synopsis", "script", "characters", "visualization", "flow", "video", "metadata", "audit"],
      "additionalProperties": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["status", "version"],
      "properties": {
        "status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "NEEDS_REVIEW", "APPROVED", "INVALIDATED", "FAILED"]},
        "version": {"type": "integer", "minimum": 0},
        "approvedAt": {"type": ["string", "null"], "format": "date-time"},
        "invalidatedReason": {"type": ["string", "null"]},
        "outputPaths": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
