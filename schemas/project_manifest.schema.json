{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project manifest, schema 3.0 with workflow 3.0.0, 3.1.0 and 3.2.0 compatibility",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "title",
    "format",
    "workflow_version",
    "workflow_git_sha",
    "targets",
    "execution",
    "character_images",
    "video",
    "google_docs",
    "private_sync"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "episodic-animation"
    },
    "workflow_version": {
      "enum": [
        "3.0.0",
        "3.1.0",
        "3.2.0"
      ]
    },
    "workflow_git_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "targets": {
      "type": "object",
      "required": [
        "episode_count",
        "episode_target_minutes",
        "script_chunks",
        "allow_subchunks"
      ],
      "properties": {
        "episode_count": {
          "type": "integer",
          "minimum": 1
        },
        "episode_target_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "runtime_tolerance_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "script_chunks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "allow_subchunks": {
          "type": "boolean"
        },
        "episode_min_runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "story_part_count": {
          "type": "integer",
          "minimum": 1
        },
        "story_parts_per_episode": {
          "type": "integer",
          "minimum": 1
        },
        "script_plan_status": {
          "enum": [
            "NOT_STARTED",
            "PLANNED",
            "IN_PROGRESS",
            "NEEDS_REVIEW",
            "ACCEPTED",
            "INVALIDATED",
            "FAILED"
          ]
        },
        "story_part_target_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "episode_scene_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "script_chunks"
            ],
            "properties": {
              "script_chunks": {
                "type": "null"
              }
            }
          },
          "then": {
            "required": [
              "script_plan_status"
            ],
            "properties": {
              "script_plan_status": {
                "const": "NOT_STARTED"
              }
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object"
    },
    "character_images": {
      "type": "object"
    },
    "video": {
      "type": "object"
    },
    "google_docs": {
      "type": "object"
    },
    "private_sync": {
      "type": "object"
    },
    "production_version": {
      "enum": [
        "NOVEL",
        "WEBTOON_EXPERIMENT"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "workflow_version"
        ],
        "properties": {
          "workflow_version": {
            "const": "3.1.0"
          }
        }
      },
      "then": {
        "properties": {
          "targets": {
            "required": [
              "episode_min_runtime_seconds",
              "story_part_count",
              "story_parts_per_episode",
              "script_plan_status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "workflow_version"
        ],
        "properties": {
          "workflow_version": {
            "const": "3.2.0"
          }
        }
      },
      "then": {
        "properties": {
          "targets": {
            "required": [
              "episode_min_runtime_seconds",
              "story_part_count",
              "story_parts_per_episode",
              "script_plan_status",
              "story_part_target_minutes",
              "episode_scene_limit"
            ]
          }
        },
        "required": [
          "production_version"
        ]
      }
    }
  ]
}
