{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public episode allocation of internal story parts, not script chunks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_version",
    "project_id",
    "status",
    "public_episode_count",
    "story_part_count",
    "story_parts_per_episode",
    "episode_target_minutes",
    "episode_min_runtime_seconds",
    "episodes"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "workflow_version": {
      "enum": [
        "3.1.0",
        "3.2.0"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "PLANNED",
        "NEEDS_REVIEW",
        "ACCEPTED",
        "INVALIDATED"
      ]
    },
    "public_episode_count": {
      "type": "integer",
      "minimum": 1
    },
    "story_part_count": {
      "type": "integer",
      "minimum": 1
    },
    "story_parts_per_episode": {
      "type": "integer",
      "minimum": 1
    },
    "episode_target_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "episode_min_runtime_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episode_id",
          "episode_number",
          "story_part_ids",
          "planned_min_runtime_seconds",
          "runtime_seconds"
        ],
        "properties": {
          "episode_id": {
            "type": "string",
            "pattern": "^EP[0-9]{2,}$"
          },
          "episode_number": {
            "type": "integer",
            "minimum": 1
          },
          "story_part_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "planned_min_runtime_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "runtime_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_evidence": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Source for an externally measured runtime: private project-relative report or media path. The structural validator does not read or measure it."
          },
          "visual_scene_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 200,
            "description": "Externally declared count; this validator does not parse or review the actual prompt files."
          },
          "image_prompt_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 200,
            "description": "Externally declared count; this validator does not parse or review the actual prompt files."
          },
          "video_prompt_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 200,
            "description": "Externally declared count, not verification of actual scene/asset content."
          },
          "motion_scene_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 200,
            "description": "Externally declared count, not verification of actual scene/asset content."
          }
        }
      }
    },
    "story_part_target_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "episode_scene_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "production_version": {
      "enum": [
        "NOVEL",
        "WEBTOON_EXPERIMENT"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "workflow_version"
        ],
        "properties": {
          "workflow_version": {
            "const": "3.2.0"
          }
        }
      },
      "then": {
        "required": [
          "story_part_target_minutes",
          "episode_scene_limit",
          "production_version"
        ],
        "properties": {
          "episodes": {
            "items": {
              "required": [
                "visual_scene_count",
                "image_prompt_count",
                "video_prompt_count",
                "motion_scene_count"
              ]
            }
          }
        }
      }
    }
  ]
}
