{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V13 chunk checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "chunk",
    "of",
    "subchunk",
    "status",
    "source_version",
    "source_sentence_ids",
    "last_scene_excerpt_file",
    "characters",
    "knowledge",
    "relationships",
    "open_threads",
    "validation",
    "output_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "chunk": {
      "type": "integer",
      "minimum": 1
    },
    "of": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "NEEDS_REVIEW",
        "ACCEPTED",
        "INVALIDATED",
        "FAILED"
      ]
    },
    "characters": {
      "type": "object"
    },
    "knowledge": {
      "type": "object"
    },
    "relationships": {
      "type": "object"
    },
    "source_sentence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
