{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V13 semantic scene (shots and keyframes separate)",
  "type": "object",
  "required": [
    "scene_id",
    "script_sentence_ids",
    "source_version"
  ],
  "properties": {
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "script_sentence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "shot_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
